# ---------------------------------------------------------------------------
# VoiceDev Orchestrator — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# App
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicedev?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI (Realtime voice intake)
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime-mini"

# Codex (initial analysis + final implementation)
CODEX_PROVIDER="cli"            # sdk | cli
CODEX_DEFAULT_MODEL=""
CODEX_WORKSPACE_ROOT="/Users/YOUR_NAME/projects"
CODEX_SANDBOX_MODE="workspace-write"
CODEX_CLI_PATH="codex"

# Anthropic / Claude (second-opinion architect/reviewer)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-4-8"
CLAUDE_CODE_PROVIDER="api"      # cli | api
CLAUDE_CODE_PATH="claude"

# Git
GIT_AUTHOR_NAME="VoiceDev Bot"
GIT_AUTHOR_EMAIL="voicedev@example.com"

# Vercel
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_ORG_ID=""
VERCEL_CLI_PATH="vercel"

# Safety
ALLOW_PRODUCTION_DEPLOY="false"
REQUIRE_CONFIRMATION_FOR_PROD="true"
MAX_RUN_MINUTES="45"
